{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sambl",
  "version": "0.1.8",
  "description": "Sambl MCP connection and diagnostic skill for Codex.",
  "author": {
    "name": "Sambl"
  },
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/sambl-setup/SKILL.md",
      "interface": {
