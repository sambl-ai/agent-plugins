        "developerName": "Sambl",
        "category": "Productivity",
        "websiteURL": "https://sambl.ai/",
        "supportURL": "https://sambl.ai/",
        "privacyPolicyURL": "https://sambl.ai/policy",
        "termsOfServiceURL": "https://sambl.ai/terms",
        "capabilities": [
          "Read",
          "Write"
        ],
        "brandColor": "#E24A3C",
        "composerIcon": "./assets/sambl-mark.png",
        "composerIconDark": "./assets/sambl-mark.png",
        "logo": "./assets/sambl-mark.png",
        "logoDark": "./assets/sambl-mark.png"
      }
    }
  }
}
